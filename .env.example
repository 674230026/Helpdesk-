# ==============================================================================
# Smart IT & Facility Helpdesk - Environment Configuration (.env.example)
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าให้เหมาะสมกับสภาพแวดล้อมของคุณ
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Smart IT Helpdesk"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/smart-it-helpdesk

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.0 / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=it_helpdesk
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback path if MySQL connection is unavailable or DB_CONNECTION=sqlite
DB_SQLITE_PATH=storage/database.sqlite

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATION SETTINGS (PHPMailer / SMTP Engine)
# ------------------------------------------------------------------------------
# ไดรเวอร์การส่งอีเมล (MAIL_MAILER):
#   - 'smtp' : ส่งอีเมลจริงผ่าน SMTP Server (เช่น Gmail, Office 365, Mailtrap)
#   - 'log'  : บันทึกสำเนา HTML ลงใน storage/mail/ เพื่อเปิดดูผ่านหน้า Admin (/admin/email-logs)
#   - 'mail' : ส่งผ่านฟังก์ชัน mail() ของ PHP
MAIL_MAILER=smtp

# Host ของ SMTP Server ที่ต้องการเชื่อมต่อ
MAIL_HOST=smtp.gmail.com

# Port การเชื่อมต่อ:
#   - 465 : สำหรับการเข้ารหัสแบบ SSL (แนะนำสำหรับ Gmail บนบางเครือข่าย)
#   - 587 : สำหรับการเข้ารหัสแบบ STARTTLS / TLS
#   - 25 / 2525 : สำหรับ Mailtrap หรือ Local SMTP Server
MAIL_PORT=465

# บัญชีผู้ใช้สำหรับล็อกอิน SMTP (เช่น อีเมล Gmail ของผู้ส่ง)
MAIL_USERNAME=your_email@gmail.com

# รหัสผ่าน SMTP:
#   *** สำคัญมากสำหรับ Gmail ***:
#   ต้องใช้ "รหัสผ่านสำหรับแอป (App Password)" 16 หลัก ที่สร้างจาก:
#   https://myaccount.google.com/apppasswords (ต้องเปิด 2-Step Verification ก่อน)
#   ห้ามใช้รหัสผ่านล็อกอิน Gmail ปกติ
MAIL_PASSWORD=your_16_digit_app_password

# รูปแบบการเข้ารหัสข้อมูล: 'ssl' (Port 465) หรือ 'tls' (Port 587)
MAIL_ENCRYPTION=ssl

# ที่อยู่อีเมลและชื่อผู้ส่งที่จะแสดงในกล่องข้อความของผู้รับ
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Smart IT Helpdesk"

# อีเมลของผู้ดูแลระบบหรือทีม IT สำหรับรับแจ้งเตือนเมื่อมีใบแจ้งซ่อมใหม่ (Ticket Created)
ADMIN_NOTIFICATION_EMAIL=admin@helpdesk.local

# ------------------------------------------------------------------------------
# 4. ตัวอย่างการตั้งค่าตามผู้ให้บริการ (PRESETS)
# ------------------------------------------------------------------------------
# ตัวอย่างที่ 1: Gmail SMTP (SSL Port 465 - แนะนำ เสถียรและไม่ถูกบล็อกพอร์ต)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=example@gmail.com
# MAIL_PASSWORD=abcdxyzmopqrstuv
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=example@gmail.com
# MAIL_FROM_NAME="Smart IT Helpdesk"

# ตัวอย่างที่ 2: Gmail SMTP (TLS Port 587)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=example@gmail.com
# MAIL_PASSWORD=abcdxyzmopqrstuv
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=example@gmail.com
# MAIL_FROM_NAME="Smart IT Helpdesk"

# ตัวอย่างที่ 3: Microsoft 365 / Outlook
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=support@yourdomain.com
# MAIL_PASSWORD=your_office365_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=support@yourdomain.com
# MAIL_FROM_NAME="Smart IT Helpdesk"

# ตัวอย่างที่ 4: Mailtrap (Sandbox สำหรับทดสอบ ไม่ส่งออกจริง)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=support@helpdesk.local
# MAIL_FROM_NAME="Smart IT Helpdesk"

# ตัวอย่างที่ 5: Local Testing Mode (จำลองการส่ง บันทึกลง storage/mail/)
# MAIL_MAILER=log
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=support@helpdesk.local
# MAIL_FROM_NAME="Smart IT Helpdesk"
